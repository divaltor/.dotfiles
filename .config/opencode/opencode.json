{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "bellno", "effect": "deny" },
    { "action": "todowrite", "resource": "*", "effect": "deny" },
    { "action": "t3-code_*", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "hidden": true
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "mcp": {
    "servers": {
      "grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false
      }
    }
  },
  "experimental": {
    "subagent_depth": 2,
    "policies": [
      {
        "action": "provider.use",
        "resource": "amazon-bedrock",
        "effect": "deny"
      }
    ]
  },
  "references": {
    "opencode": {
      "repository": "anomalyco/opencode",
      "description": "Official repo of Opencode"
    }
  },
  "websearch": {
    "provider": "exa"
  },
  "default_agent": "diana"
}
