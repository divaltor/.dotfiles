{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "plugins": [
    {
      "package": "@divaltor/academy@0.4.1",
      "options": {
        "agents": {
          "rudolf": {
            "color": "#8994B8",
            "name": "diana"
          }
        },
        "experimental": {
          "communication": {
            "enabled": true
          }
        }
      }
    }
  ],
  "permissions": [
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "t3-code_*",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "providers": {
    "openai": {
      "settings": {
        "textVerbosity": "low"
      }
    },
    "github-copilot": {
      "settings": {
        "textVerbosity": "low"
      }
    }
  },
  "mcp": {
    "servers": {
      "grafana": {
        "type": "local",
        "command": ["uvx", "mcp-grafana@latest", "--loki-guardrail-mode=enforce"],
        "disabled": true,
        "environment": {
          "GRAFANA_URL": "https://monitoring.divaltor.dev",
          "GRAFANA_API_KEY": "{env:GRAFANA_API_KEY}"
        }
      }
    }
  },
  "experimental": {
    "subagent_depth": 2,
    "policies": [
      {
        "action": "provider.use",
        "resource": "amazon-bedrock",
        "effect": "deny"
      }
    ]
  },
  "references": {
    "opencode": {
      "repository": "anomalyco/opencode",
      "description": "Official repo of Opencode"
    }
  },
  "websearch": {
    "provider": "exa"
  }
}
