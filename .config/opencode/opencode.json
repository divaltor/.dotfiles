{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "plugins": [
    {
      "package": "@divaltor/academy@latest",
      "options": {
        "agents": {
          "rudolf": {
            "color": "#8994B8",
            "name": "diana"
          },
          "bellno": {
            "model": "github-copilot/claude-opus-5.5#medium"
          }
        },
        "use_fff": true
      }
    }
  ],
  "permissions": [
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "providers": {
    "openai": {
      "settings": {
        "textVerbosity": "low",
        "compaction": {
          "type": "native"
        }
      }
    },
    "anthropic": {
      "settings": {
        "cache": {
          "ttl": "1h"
        }
      }
    },
    "github-copilot": {
      "settings": {
        "textVerbosity": "low"
      }
    }
  },
  "mcp": {
    "servers": {
      "grafana": {
        "type": "local",
        "command": ["uvx", "mcp-grafana@latest", "--loki-guardrail-mode=enforce"],
        "disabled": true,
        "environment": {
          "GRAFANA_URL": "https://monitoring.divaltor.dev",
          "GRAFANA_API_KEY": "{env:GRAFANA_API_KEY}"
        }
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp"
      },
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "disabled": true
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/readonly",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}",
          "X-MCP-Toolsets": "repos,pull_requests,issues,actions"
        }
      }
    }
  },
  "experimental": {
    "subagent_depth": 2,
    "policies": [
      {
        "action": "provider.use",
        "resource": "amazon-bedrock",
        "effect": "deny"
      }
    ],
    "background_compaction": true
  },
  "references": {
    "opencode": {
      "repository": "anomalyco/opencode",
      "description": "Official repo of Opencode"
    }
  },
  "websearch": {
    "provider": "exa"
  }
}
