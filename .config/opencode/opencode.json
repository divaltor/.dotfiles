{
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "general": {
      "permission": {
        "task": "deny"
      }
    }
  },
  "lsp": true,
  "formatter": true,
  "permission": {
    "*": "allow",
    "task": {
      "*": "allow",
      "bellno": "deny"
    },
    "todowrite": "deny",
    "t3-code_*": "deny"
  },
  "mcp": {
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  },
  "experimental": {
    "openTelemetry": true
  },
  "references": {
    "opencode": {
      "repository": "anomalyco/opencode",
      "description": "Official repo of Opencode"
    }
  },
  "default_agent": "diana",
  "subagent_depth": 2,
  "disabled_providers": [
    "amazon-bedrock"
  ],
  "$schema": "https://opencode.ai/config.json"
}
