{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "bellno", "effect": "deny" },
    { "action": "todowrite", "resource": "*", "effect": "deny" },
    { "action": "t3-code_*", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "hidden": true
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  },
  "provider": {
    "openai": {
      "options": {
        "textVerbosity": "low"
      }
    },
    "github-copilot": {
      "options": {
        "textVerbosity": "low"
      }
    }
  },
  "mcp": {
    "servers": {
      "grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false
      },
      "grafana": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-grafana@latest",
          "--loki-guardrail-mode=enforce"
        ],
        "environment": {
          "GRAFANA_URL": "https://monitoring.local",
          "GRAFANA_API_KEY": "{env:GRAFANA_API_KEY}"
        }
      }
    }
  },
  "experimental": {
    "subagent_depth": 2,
    "policies": [
      {
        "action": "provider.use",
        "resource": "amazon-bedrock",
        "effect": "deny"
      }
    ]
  },
  "references": {
    "opencode": {
      "repository": "anomalyco/opencode",
      "description": "Official repo of Opencode"
    }
  },
  "websearch": {
    "provider": "exa"
  },
  "default_agent": "diana"
}
