global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:{{ monitoring_prometheus_port }}"]

  - job_name: node
    static_configs:
{% for exporter in monitoring_node_exporter_targets %}
      - targets: ["{{ exporter.address }}"]
        labels:
          name: "{{ exporter.name }}"
          role: "{{ exporter.role }}"
{% endfor %}

  - job_name: cadvisor
    static_configs:
{% for exporter in monitoring_cadvisor_targets %}
      - targets: ["{{ exporter.address }}"]
        labels:
          host: "{{ exporter.name }}"
          role: "{{ exporter.role }}"
{% endfor %}

  - job_name: proxmox
    metrics_path: /pve
    params:
      module: [default]
      cluster: ["1"]
      node: ["1"]
    static_configs:
      - targets: ["{{ monitoring_pve_target }}"]
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "127.0.0.1:{{ monitoring_pve_exporter_port }}"
