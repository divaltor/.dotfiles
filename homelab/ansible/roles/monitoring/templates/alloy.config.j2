otelcol.auth.bearer "ingress" {
  token = sys.env("ALLOY_OTLP_TOKEN")
}

otelcol.auth.bearer "axiom" {
  token = sys.env("AXIOM_API_TOKEN")
}

otelcol.receiver.otlp "gateway" {
  grpc {
    endpoint = "0.0.0.0:{{ monitoring_otlp_grpc_port }}"
    auth     = otelcol.auth.bearer.ingress.handler
  }

  http {
    endpoint = "0.0.0.0:{{ monitoring_otlp_http_port }}"
    auth     = otelcol.auth.bearer.ingress.handler
  }

  output {
    metrics = [otelcol.processor.memory_limiter.gateway.input]
    logs    = [otelcol.processor.memory_limiter.gateway.input]
    traces  = [otelcol.processor.memory_limiter.gateway.input]
  }
}

otelcol.processor.memory_limiter "gateway" {
  check_interval = "1s"
  limit          = "512MiB"
  spike_limit    = "128MiB"

  output {
    metrics = [otelcol.processor.batch.gateway.input]
    logs    = [otelcol.processor.batch.gateway.input]
    traces  = [otelcol.processor.batch.gateway.input]
  }
}

otelcol.processor.batch "gateway" {
  timeout             = "1s"
  send_batch_size     = 2000
  send_batch_max_size = 3000

  output {
    metrics = [otelcol.exporter.prometheus.local.input, otelcol.processor.filter.axiom_starlight.input]
    logs    = [otelcol.exporter.loki.local.input, otelcol.processor.filter.axiom_starlight.input]
    traces  = [otelcol.exporter.otlp.tempo.input, otelcol.processor.filter.axiom_starlight.input]
  }
}

otelcol.processor.filter "axiom_starlight" {
  error_mode = "ignore"

  metrics {
    metric = [
      `resource.attributes["service.name"] == nil or not IsMatch(resource.attributes["service.name"], "^starlight($|-)")`,
    ]
  }

  logs {
    log_record = [
      `resource.attributes["service.name"] == nil or not IsMatch(resource.attributes["service.name"], "^starlight($|-)")`,
    ]
  }

  traces {
    span = [
      `resource.attributes["service.name"] == nil or not IsMatch(resource.attributes["service.name"], "^starlight($|-)")`,
    ]
  }

  output {
    metrics = [otelcol.exporter.otlphttp.axiom_metrics.input]
    logs    = [otelcol.exporter.otlphttp.axiom_logs.input]
    traces  = [otelcol.exporter.otlphttp.axiom_traces.input]
  }
}

otelcol.exporter.prometheus "local" {
  forward_to = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://127.0.0.1:{{ monitoring_prometheus_port }}/api/v1/write"
  }
}

otelcol.exporter.loki "local" {
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:{{ monitoring_loki_port }}/loki/api/v1/push"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "127.0.0.1:{{ monitoring_tempo_otlp_grpc_port }}"
    tls {
      insecure = true
    }
  }
}

otelcol.exporter.otlphttp "axiom_traces" {
  client {
    endpoint    = "https://api.axiom.co"
    auth        = otelcol.auth.bearer.axiom.handler
    compression = "zstd"
    headers = {
      "X-Axiom-Dataset" = sys.env("AXIOM_TRACES_DATASET"),
    }
  }
}

otelcol.exporter.otlphttp "axiom_logs" {
  client {
    endpoint    = "https://api.axiom.co"
    auth        = otelcol.auth.bearer.axiom.handler
    compression = "zstd"
    headers = {
      "X-Axiom-Dataset" = sys.env("AXIOM_LOGS_DATASET"),
    }
  }
}

otelcol.exporter.otlphttp "axiom_metrics" {
  client {
    endpoint    = "https://api.axiom.co"
    auth        = otelcol.auth.bearer.axiom.handler
    compression = "zstd"
    headers = {
      "X-Axiom-Metrics-Dataset" = sys.env("AXIOM_METRICS_DATASET"),
    }
  }
}
