[Unit]
Description=Prometheus exporter for Proxmox VE
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=prometheus-pve-exporter
Group=prometheus-pve-exporter
Environment=REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ExecStart=/opt/prometheus-pve-exporter/bin/pve_exporter --config.file=/etc/prometheus/pve.yml --web.listen-address=127.0.0.1:{{ monitoring_pve_exporter_port }}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
