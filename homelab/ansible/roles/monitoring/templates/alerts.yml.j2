{% raw %}
groups:
  - name: infrastructure
    rules:
      - alert: ExporterDown
        expr: up == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Metrics target {{ $labels.instance }} is down"

      - alert: FilesystemNearlyFull
        expr: |
          100 * (1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay"}) > 90
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Filesystem {{ $labels.mountpoint }} on {{ $labels.instance }} is over 90% full"

      - alert: PhysicalDiskSaturated
        expr: rate(node_disk_io_time_seconds_total{role="hypervisor",device!~"dm-.*|zd.*|loop.*"}[5m]) > 0.95
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Disk {{ $labels.device }} on {{ $labels.instance }} is saturated"
{% endraw %}
