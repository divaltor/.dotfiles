{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [
        {"expr": "rate(node_disk_read_bytes_total{instance=~\"$instance\",device=~\"$device\"}[$__rate_interval])", "legendFormat": "{{instance}} {{device}} read", "refId": "A"},
        {"expr": "rate(node_disk_written_bytes_total{instance=~\"$instance\",device=~\"$device\"}[$__rate_interval])", "legendFormat": "{{instance}} {{device}} write", "refId": "B"}
      ],
      "title": "Disk throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "iops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [
        {"expr": "rate(node_disk_reads_completed_total{instance=~\"$instance\",device=~\"$device\"}[$__rate_interval])", "legendFormat": "{{instance}} {{device}} read", "refId": "A"},
        {"expr": "rate(node_disk_writes_completed_total{instance=~\"$instance\",device=~\"$device\"}[$__rate_interval])", "legendFormat": "{{instance}} {{device}} write", "refId": "B"}
      ],
      "title": "Disk IOPS",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [
        {"expr": "1000 * rate(node_disk_read_time_seconds_total{instance=~\"$instance\",device=~\"$device\"}[$__rate_interval]) / clamp_min(rate(node_disk_reads_completed_total{instance=~\"$instance\",device=~\"$device\"}[$__rate_interval]), 0.001)", "legendFormat": "{{instance}} {{device}} read", "refId": "A"},
        {"expr": "1000 * rate(node_disk_write_time_seconds_total{instance=~\"$instance\",device=~\"$device\"}[$__rate_interval]) / clamp_min(rate(node_disk_writes_completed_total{instance=~\"$instance\",device=~\"$device\"}[$__rate_interval]), 0.001)", "legendFormat": "{{instance}} {{device}} write", "refId": "B"}
      ],
      "title": "Average I/O latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [
        {"expr": "100 * rate(node_disk_io_time_seconds_total{instance=~\"$instance\",device=~\"$device\"}[$__rate_interval])", "legendFormat": "{{instance}} {{device}}", "refId": "A"}
      ],
      "title": "Disk utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 5,
      "targets": [
        {"expr": "rate(pve_disk_read_bytes_total{id=~\"qemu/.*|lxc/.*\"}[$__rate_interval])", "legendFormat": "{{id}} read", "refId": "A"},
        {"expr": "rate(pve_disk_written_bytes_total{id=~\"qemu/.*|lxc/.*\"}[$__rate_interval])", "legendFormat": "{{id}} write", "refId": "B"}
      ],
      "title": "VM and LXC disk throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 6,
      "targets": [
        {"expr": "100 * rate(node_zfs_arc_hits{instance=~\"$instance\"}[5m]) / clamp_min(rate(node_zfs_arc_hits{instance=~\"$instance\"}[5m]) + rate(node_zfs_arc_misses{instance=~\"$instance\"}[5m]), 0.001)", "legendFormat": "{{instance}}", "refId": "A"}
      ],
      "title": "ZFS ARC hit ratio",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["homelab", "storage", "proxmox"],
  "templating": {
    "list": [
