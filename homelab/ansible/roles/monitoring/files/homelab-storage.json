      {"current": {}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "definition": "label_values(node_disk_reads_completed_total{instance=~\"$instance\"}, device)", "includeAll": true, "label": "Device", "multi": true, "name": "device", "query": {"query": "label_values(node_disk_reads_completed_total{instance=~\"$instance\"}, device)", "refId": "PrometheusVariableQueryEditor-VariableQuery"}, "refresh": 1, "type": "query"}
    ]
  },
