[Unit]
Description=Openship control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/root/.openship/bin/openship up --foreground --port {{ openship_api_port }} --dashboard-port {{ openship_dashboard_port }} --public-url {{ openship_public_url }} --host 127.0.0.1
Restart=always
RestartSec=2
Environment=NODE_ENV=production
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/.openship/bin

[Install]
WantedBy=default.target
