# Generated by Ansible — do not edit manually

# New users default to isolated directories below the ZFS bind mount. Set a
# user's home to {{ sftpgo_storage_path }} in WebAdmin only when full-pool
# access is intended.
SFTPGO_DATA_PROVIDER__USERS_BASE_DIR={{ sftpgo_storage_path }}
SFTPGO_COMMON__UMASK=002
SFTPGO_COMMON__DEFENDER__ENABLED=true
SFTPGO_COMMON__MAX_PER_HOST_CONNECTIONS=10

# Caddy provides private local HTTPS for WebAdmin/WebClient. The installation
# code prevents another LAN user from claiming the first administrator.
SFTPGO_HTTPD__BINDINGS__0__ADDRESS=127.0.0.1
SFTPGO_HTTPD__SETUP__INSTALLATION_CODE={{ sftpgo_installation_code | quote }}

# A separate loopback listener lets Funnel expose WebClient without exposing
# WebAdmin or the REST API publicly.
SFTPGO_HTTPD__BINDINGS__1__ADDRESS=127.0.0.1
SFTPGO_HTTPD__BINDINGS__1__PORT={{ sftpgo_webclient_port }}
SFTPGO_HTTPD__BINDINGS__1__ENABLE_WEB_ADMIN=false
SFTPGO_HTTPD__BINDINGS__1__ENABLE_WEB_CLIENT=true
SFTPGO_HTTPD__BINDINGS__1__ENABLE_REST_API=false
SFTPGO_HTTPD__BINDINGS__1__RENDER_OPENAPI=false

# SFTP is available on the LAN/tailnet at 2022. WebDAV listens locally;
# Tailscale Funnel exposes it separately from WebClient.
SFTPGO_SFTPD__BINDINGS__0__PORT=2022
SFTPGO_WEBDAVD__BINDINGS__0__ADDRESS=127.0.0.1
SFTPGO_WEBDAVD__BINDINGS__0__PORT={{ sftpgo_webdav_port }}
