[Unit]
Description=Amp remote runner
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=amp
Group=amp
WorkingDirectory=/workspace/personal
EnvironmentFile=/etc/amp-runner.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/amp/.local/bin
ExecStart=/home/amp/.local/bin/amp --no-tui --runner-id opera --remote-control-terminal
Restart=on-failure
RestartSec=5s
PrivateTmp=true

[Install]
WantedBy=multi-user.target
